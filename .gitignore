# Build artifacts (regenerated by build scripts / CI — never commit)
/output/
/artifacts/
imagefs.txz
imagefs.txz.sha256sum
patches/

# Intermediate build files (generated by build-all.sh)
cache/
logs/
built-pkgs/
workdir/

# Don't commit archives / checksums produced by packaging
*.txz
*.tar.xz
*.tar.bz2
*.tar.gz
*.sha256sum

# OS files
.DS_Store
*.swp
*~
