# Generated by buildstream/sync-arch-elements.py from buildstream/recipes/ — edit the recipe, then re-run the sync.
kind: cmake

description: |
  PCRE2 10.44 8-bit shared library with Unicode and JIT enabled.

depends:
- filename: host/noble-amd64.bst
  junction: buildstream-sdk.bst
  type: build
- filename: toolchains/android-ndk-r29.bst
  junction: buildstream-sdk.bst
  type: build

sources:
- kind: tar
  url: pcre2:pcre2-10.44/pcre2-10.44.tar.bz2
  ref: d34f02e113cf7193a1ebf2770d3ac527088d485d4e047ed10e5d217c6ef5de96

variables:
  target-triple: x86_64-linux-android30
  ndk-libdir-triple: x86_64-linux-android
  android-cpu: x86_64
  cmake-local: >-
    -DBUILD_SHARED_LIBS=ON
    -DBUILD_STATIC_LIBS=OFF
    -DPCRE2_BUILD_PCRE2GREP=OFF
    -DPCRE2_BUILD_TESTS=OFF
    -DPCRE2_SUPPORT_UNICODE=ON
    -DPCRE2_SUPPORT_JIT=ON

config:
  strip-commands:
  - |
    find "%{install-root}%{prefix}/lib" -type f -name 'libpcre2*.so*' \
      -exec "$STRIP" {} +
