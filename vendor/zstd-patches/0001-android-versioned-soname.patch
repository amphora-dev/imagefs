diff --git a/build/cmake/lib/CMakeLists.txt b/build/cmake/lib/CMakeLists.txt
index 85adbf3..4120e1d 100644
--- a/build/cmake/lib/CMakeLists.txt
+++ b/build/cmake/lib/CMakeLists.txt
@@ -8,6 +8,11 @@
 
 project(libzstd C ASM)
 
+# The Android CMake platform suppresses versioned SONAMEs even when a target
+# declares SOVERSION. imagefs consumers request libzstd.so.1, so preserve
+# zstd's upstream SOVERSION metadata in the linked ELF instead of using patchelf.
+set(CMAKE_PLATFORM_NO_VERSIONED_SONAME OFF)
+
 set(CMAKE_INCLUDE_CURRENT_DIR TRUE)
 option(ZSTD_BUILD_STATIC "BUILD STATIC LIBRARIES" ON)
 option(ZSTD_BUILD_SHARED "BUILD SHARED LIBRARIES" ON)
