diff --git a/src/gallium/frontends/dri/kopper.c b/src/gallium/frontends/dri/kopper.c
--- a/src/gallium/frontends/dri/kopper.c	2026-08-02 14:22:42.002221341 +0000
+++ b/src/gallium/frontends/dri/kopper.c	2026-08-02 14:22:42.010221300 +0000
@@ -315,10 +315,23 @@
                data = &drawable->info;
             else
                data = drawable->textures[ST_ATTACHMENT_BACK_LEFT];
-            assert(data);
-            drawable->textures[statts[i]] =
-               screen->base.screen->resource_create_drawable(screen->base.screen, &templ, data);
-            drawable->window_valid = !!drawable->textures[statts[i]];
+            /* A double-buffered front buffer borrows the back buffer's
+             * swapchain, but statts[] is walked in enum order and
+             * ST_ATTACHMENT_FRONT_LEFT sorts before ST_ATTACHMENT_BACK_LEFT,
+             * so the back texture is still NULL here on the first pass (and on
+             * every revalidate, which releases it). assert(data) is compiled
+             * out in release builds, and zink's frontbuffer path dereferences
+             * loader_private as a zink_resource without checking, so this used
+             * to hand it a NULL/stale pointer and segfault in
+             * zink_kopper_set_readback_needs_update. Fall through to the plain
+             * resource below instead: that yields a fake front buffer, which is
+             * what drivers without real front-buffer rendering provide anyway.
+             */
+            if (data) {
+               drawable->textures[statts[i]] =
+                  screen->base.screen->resource_create_drawable(screen->base.screen, &templ, data);
+               drawable->window_valid = !!drawable->textures[statts[i]];
+            }
          }
 #ifdef VK_USE_PLATFORM_XCB_KHR
          else if (is_pixmap && statts[i] == ST_ATTACHMENT_FRONT_LEFT && !screen->is_sw) {
