--- a/src/gallium/drivers/zink/zink_kopper.c
+++ b/src/gallium/drivers/zink/zink_kopper.c
@@ -949,6 +949,16 @@
 zink_kopper_set_readback_needs_update(struct zink_resource *res)
 {
    struct kopper_displaytarget *cdt = res->obj->dt;
+   /* dt_idx is UINT32_MAX until AcquireNextImage, and present resets it to
+    * UINT32_MAX again. image_barrier still calls here on every write to a
+    * swapchain resource — including DirectDraw/WineD3D front-buffer paths
+    * that hit the barrier before the next acquire — so indexing
+    * images[UINT32_MAX] is a guaranteed OOB segfault. Other kopper callers
+    * already guard on dt_idx; match them. Nothing to mark until an image is
+    * actually acquired.
+    */
+   if (!cdt || !cdt->swapchain || res->obj->dt_idx == UINT32_MAX)
+      return;
    struct kopper_swapchain *cswap = cdt->swapchain;
    cswap->images[res->obj->dt_idx].readback_needs_update = true;
 }
