diff --git a/src/util/detect_os.h b/src/util/detect_os.h
index 86286df..a03e0af 100644
--- a/src/util/detect_os.h
+++ b/src/util/detect_os.h
@@ -23,8 +23,13 @@
 /*
  * Android defines __linux__, so DETECT_OS_LINUX and DETECT_OS_POSIX will
  * also be defined.
+ *
+ * Termux/Pipetto wrapper builds define __TERMUX__ and want Linux Mesa paths
+ * (inline sync_merge, getenv options, no liblog/libcutils DT_NEEDED). Keep
+ * Android NDK toolchain + android-stub headers for AHardwareBuffer, but do
+ * not treat the host as AOSP DETECT_OS_ANDROID.
  */
-#if defined(__ANDROID__)
+#if defined(__ANDROID__) && !defined(__TERMUX__)
 #define DETECT_OS_ANDROID 1
 #endif
 
